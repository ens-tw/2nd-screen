// The status page: the board as one self-contained HTML page (inline CSS, no external assets) for a
// person, readable on a phone, at a git-ignored path (`view` and every probing `next` rewrite it) and
// never committed. The board is tickets/board.mts and agents read it through the CLI's JSON — the page
// says so at its top, in a comment and a banner, so an agent that opens it anyway is told to stop. It
// shows what the
// Markdown view repos used to commit showed, plus each member summary: open tickets in
// priority order with their holds (derived ones marked ←), hazard, next or members, wip, done condition
// and what they unblock; the resources and who waits on each; the done-by-judgment list; paused tickets
// by what resumes them; the done/dropped count. Deterministic for a board and its stamp (version, commit,
// time — passed in): it reads the board, the config and repo files only — no clock, no probe, every
// hold counts.
import type { Board, Ctx, Ticket } from './types.mts';
import { authorizationsOf, dependents, describeDone, describeHolds, holdsOf, isClosed, isLive, memberLabel, memberSummary, membersOf } from './lib.mts';

/** The markers of the Markdown view a repo committed before 0.5.0. `check` warns while a doc still holds
 *  the block between them (view-doc-leftover): delete it — there is no committed view any more. */
export const BEGIN = '<!-- ticket-board:begin — generated from tickets/board.mts by `node tickets/engine/cli.mjs write`; edit the board, not this block -->';
export const END = '<!-- ticket-board:end -->';
const BEGIN_PREFIX = '<!-- ticket-board:begin';

/** Does a doc still hold the pre-0.5.0 view block (both markers, in order)? */
export const hasMarkers = (doc: string): boolean => {
  const i = doc.indexOf(BEGIN_PREFIX);
  return i >= 0 && doc.indexOf(END, i) > i;
};

const ESC: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
const esc = (s: string): string => s.replace(/[&<>"']/g, (c) => ESC[c]);

const CSS = `
:root { color-scheme: light dark; --dim: #6b7280; --line: #d1d5db; --warn: #b45309; --tag: #eef2ff; }
@media (prefers-color-scheme: dark) { :root { --dim: #9ca3af; --line: #374151; --warn: #f59e0b; --tag: #1e1b4b; } }
* { box-sizing: border-box; }
body { font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans", "PingFang TC", sans-serif; margin: 0 auto; padding: 1rem; max-width: 48rem; overflow-wrap: anywhere; }
h1 { font-size: 1.4rem; margin: 0 0 .25rem; } h2 { font-size: 1.15rem; margin: 1.5rem 0 .5rem; border-bottom: 1px solid var(--line); } h3 { font-size: 1rem; margin: 1rem 0 .25rem; }
ol, ul { padding-left: 1.25rem; } li { margin: 0 0 .9rem; }
.dim, .note { color: var(--dim); font-size: .9rem; } .hazard { color: var(--warn); font-weight: 600; }
.id { font-weight: 700; } .st { font-size: .75rem; padding: 0 .4rem; border-radius: .6rem; background: var(--tag); white-space: nowrap; }
.banner { border: 2px solid var(--warn); border-radius: .4rem; padding: .5rem .75rem; margin: 0 0 1rem; font-size: .9rem; }
.holds { font-style: italic; } code { font-size: .9em; } details { margin-top: .25rem; } summary { cursor: pointer; }
`;

function item(t: Ticket, b: Board, cx: Ctx, deps: Map<string, string[]>): string {
  if (!isLive(t)) return '';
  const hs = holdsOf(t.id, b, cx);
  const ms = membersOf(t.id, b, cx);
  const rows = [`<div><span class="id">${esc(t.id)}</span> ${esc(t.title)} <span class="st">${hs.length ? 'held' : 'open'}</span></div>`];
  if (hs.length) rows.push(`<div class="holds">${describeHolds(hs).map(esc).join('<br>')}</div>`);
  if (t.hazard) rows.push(`<div class="hazard">⚠ ${esc(t.hazard)}</div>`);
  for (const a of authorizationsOf(t, cx)) rows.push(`<div>Authorization <b>${esc(a.name)}</b>: ${esc(a.state)} — ${esc(a.what)}${a.grant ? ` (${esc(a.grant.source)}: ${esc(a.grant.quote)})` : ''}</div>`);
  if (ms) {
    rows.push(`<div><b>Members:</b> ${esc(memberSummary(ms, b))}</div>`);
    if (ms.unmet.length) {
      const li = ms.unmet.map((m) => `<li><b>${esc(m.id)}</b> — ${esc(memberLabel(m) || 'workable')}${m.note ? `<br><span class="note">${esc(m.note)}</span>` : ''}</li>`);
      rows.push(`<details><summary>the ${ms.unmet.length} not met</summary><ul>${li.join('')}</ul></details>`);
    }
  } else rows.push(`<div><b>Next:</b> ${esc(t.next ?? '')}</div>`);
  if (t.wip) rows.push(`<div>WIP on branch <code>${esc(t.wip)}</code></div>`);
  rows.push(`<div><b>Done when:</b> ${esc(describeDone(t.doneWhen, cx))}</div>`);
  const unblocks = deps.get(t.id);
  if (unblocks) rows.push(`<div class="dim">Unblocks ${esc(unblocks.join(', '))}</div>`);
  return `<li id="${esc(t.id)}">\n${rows.join('\n')}\n</li>`;
}

/** What the page says about itself, first thing: who made it from what, and that an agent must not use it. */
export const pageNotice = (o: { version: string; from: string; generated: string }): string =>
  `Generated by ticket-board ${o.version} from ${o.from} at ${o.generated}. A disposable snapshot for humans — agents must not read, cite or edit this file; query \`node tickets/engine/cli.mjs list|next|show --json\` instead.`;

/** The page. `name` = the repo's name; `version` = the engine's; `from` = HEAD's short hash, `+dirty`
 *  when the work tree has changes; `generated` = when (all passed in, never computed here). */
export function renderHtml(b: Board, cx: Ctx, o: { name: string; version: string; from: string; generated: string }): string {
  const deps = dependents(b, cx);
  const live = b.filter(isLive);
  const paused = b.filter((t) => t.status === 'paused');
  const closed = b.filter(isClosed);
  const count = (s: string) => b.filter((t) => t.status === s).length;
  const groups = Object.entries(cx.config.groups);
  const notice = pageNotice(o);
  const out = [
    `<!-- ${notice.replace(/-->/g, '—>')} -->`, '<!doctype html>', '<html lang="en">', '<head>', '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">',
    `<title>${esc(o.name)} — tickets</title>`, `<style>${CSS}</style>`, '</head>', '<body>',
    `<div class="banner" role="note">${esc(notice).replace(/`([^`]+)`/g, '<code>$1</code>')}</div>`,
    `<h1>${esc(o.name)} — tickets</h1>`,
    `<p>${count('open')} open (${live.filter((t) => holdsOf(t.id, b, cx).length).length} held) · ${count('paused')} paused · ${count('done')} done · ${count('dropped')} dropped</p>`,
    '<h2>Open, in priority order</h2>', '<p class="dim">Holds marked ← are derived, not written.</p>',
  ];
  const list = (ts: Ticket[]) => ['<ol>', ...ts.map((t) => item(t, b, cx, deps)), '</ol>'];
  if (!live.length) out.push('<p><i>Nothing open.</i></p>');
  else if (!groups.length) out.push(...list(live));
  else {
    const sections: [string, Ticket[]][] = groups.map(([k, label]) => [label, live.filter((t) => t.group === k)]);
    const loose = live.filter((t) => !t.group || !Object.prototype.hasOwnProperty.call(cx.config.groups, t.group));
    if (loose.length) sections.push(['Ungrouped', loose]);
    for (const [label, ts] of sections) if (ts.length) out.push(`<h3>${esc(label)}</h3>`, ...list(ts));
  }
  const resources = Object.entries(cx.config.resources);
  if (resources.length) {
    out.push('<h2>Resources</h2>', '<ul>');
    for (const [name, r] of resources) {
      const on = r.on === undefined ? [] : Array.isArray(r.on) ? r.on : [r.on];
      const where = on.length ? `on ${on.join(', ')}` : r.probe ? 'probed' : 'no box and no probe — never reachable';
      const notes = [r.policy, r.bringUp && `bring-up: ${r.bringUp}`].filter(Boolean).join('; ');
      out.push(`<li><b>${esc(name)}</b> (${esc(where)}; ${r.paths.map((p) => `<code>${esc(p)}</code>`).join(', ')})${notes ? ` — ${esc(notes)}` : ''} → ${esc(deps.get(name)?.join(', ') ?? 'nothing waiting')}</li>`);
    }
    out.push('</ul>');
  }
  const judged = b.filter((t) => !isClosed(t) && 'doneWhen' in t && t.doneWhen.kind === 'judgment');
  if (judged.length) out.push('<h2>Done by judgment</h2>', `<p>No check can close these, so a human must: ${esc(judged.map((t) => t.id).join(', '))}</p>`);
  if (paused.length) {
    out.push(`<h2>Paused (${paused.length})</h2>`, '<ul>');
    const byUntil = new Map<string, string[]>();
    for (const t of paused) if (t.status === 'paused') byUntil.set(t.until, [...(byUntil.get(t.until) ?? []), `${t.id} ${t.title}`]);
    for (const [until, items] of byUntil) out.push(`<li><i>Until ${esc(until)}:</i> ${esc(items.join(' · '))}</li>`);
    out.push('</ul>');
  }
  out.push(`<p class="dim">Done / dropped on the board: ${closed.length} — a done ticket's record is its commit (<code>git show &lt;commit&gt;</code>), a dropped one's is its reason.</p>`, '</body>', '</html>', '');
  return out.join('\n');
}
