; 被動 SPI 擷取（防護評估用）— 只抄匯流排上的位元組，不含任何還原邏輯。
;
; 接線慣例（在 spi_tap.c 設定）：
;   IN base 腳      = DI （資料線）
;   IN base + 1 腳  = CLK（時脈）        ← 故 DI、CLK、CS 必須是連號 GPIO
;   IN base + 2 腳  = CS （同時是 jmp_pin；低電位有效）
;
; 預設 SPI mode 0：CS 拉低期間，於 CLK 上升緣取樣 DI。
; 若實測為其他 CPOL/CPHA，改 wait 的邊緣極性即可。
; autopush 設 8：每湊滿 8 bit 自動推一個位元組進 RX FIFO。
;
; 這條匯流排每個 byte 都有自己的 CS 脈衝。每個脈衝只取 8 bit，取完等 CS 拉高，
; 多或少一個 CLK 緣都只影響當下的 byte，不會讓之後的資料持續錯位。

.program spi_tap

.wrap_target
    jmp pin, cs_high           ; CS 仍高 → 繼續等
    mov isr, null              ; 新 byte 從 bit 0 開始
    set x, 7
bitloop:
    wait 1 pin 1               ; 等 CLK 上升緣（IN base + 1）
    in   pins, 1               ; 取樣 DI 一個 bit（IN base）；湊滿 8 bit autopush
    wait 0 pin 1               ; 等 CLK 回落
    jmp x--, bitloop
cs_high:
    wait 1 pin 2               ; 等 CS 拉高，這段期間多餘的 CLK 緣都不取樣
.wrap
